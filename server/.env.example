# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=            # permanent access token (System User token)
PHONE_NUMBER_ID=           # from WhatsApp > API Setup
VERIFY_TOKEN=nhbrc-verify-123   # any string you choose; paste same value in Meta webhook setup
APP_SECRET=                # Meta App > Settings > Basic > App Secret (used to verify webhook signatures)
GRAPH_API_VERSION=v23.0

# --- Server ---
PORT=3001

# --- NHBRC contact details shown to users (verify at www.nhbrc.org.za) ---
NHBRC_PHONE=0800 200 824
NHBRC_WEB=www.nhbrc.org.za
NHBRC_ADDRESS=27 Leeuwkop Road, Sunninghill, Johannesburg, 2157
NHBRC_ETHICS=0800 203 698

# Office hours shown for every office (CONFIRM with NHBRC – this is a placeholder)
NHBRC_HOURS=Mon–Fri 08:00–16:30

# --- Certificate status check ---
# mock = built-in fake test numbers (1234567 valid, 7654321 expired, 5555555 suspended)
# http = call a real NHBRC registration-lookup service (see README, section "Status check")
STATUS_PROVIDER=mock
STATUS_API_URL=
STATUS_API_KEY=
